---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

// Obtener los productos y categorías desde las colecciones
const productosData = await getCollection('productos');
const categoriasData = await getCollection('categorias');
const productosDestacados = productosData.filter(producto => producto.data.destacado);

// Mapa de slug de categoría -> Nombre legible
const categoriasMap = new Map<string, string>();
for (const cat of categoriasData) {
	categoriasMap.set(cat.id, cat.data.nombre);
}

// Función para obtener el nombre legible de la categoría de un producto
const getNombreCategoria = (catSlugOrName: string) => {
	return categoriasMap.get(catSlugOrName) || catSlugOrName;
};

// Construir lista de categorías para los botones de filtro (incluyendo las de la colección y cualquier categoría adicional en productos)
const conteoPorCategoria = new Map<string, number>();
for (const prod of productosDestacados) {
	const catKey = prod.data.categoria;
	conteoPorCategoria.set(catKey, (conteoPorCategoria.get(catKey) || 0) + 1);
	if (!categoriasMap.has(catKey)) {
		categoriasMap.set(catKey, catKey);
	}
}

const listaCategorias = Array.from(categoriasMap.entries()).map(([slug, nombre]) => ({
	slug,
	nombre,
	count: conteoPorCategoria.get(slug) || 0,
}));

// Imagen principal del Hero (esta se queda manual porque es estática de diseño)
import principalImg from '../assets/imgs/principal.jpeg';

// Obtener el número de WhatsApp desde las variables de entorno
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '593000000000';
---

<Layout title="Inicio - Sakura Lab">
	<Header />
	
	<main class="pt-24 pb-32 max-w-7xl mx-auto px-6">
		<section class="grid md:grid-cols-2 gap-12 items-center mb-24 min-h-716px">
			<div class="flex flex-col items-start gap-6 max-w-xl">
				<span class="text-primary font-label text-xs tracking-[0.2em] uppercase font-bold">Artesanía &amp; Tecnología</span>
				<h1 class="font-serif text-5xl md:text-7xl font-bold text-on-surface leading-[1.1] italic">
					Sakura Lab: detalles que florecen
				</h1>
				<p class="text-on-surface-variant text-lg leading-relaxed">
					Personalizamos tus momentos especiales con tecnología 3D, grabado láser de alta precisión y sublimación artesanal.
				</p>
				<a href="#galeria" class="group bg-primary text-on-primary px-8 py-4 rounded-xl font-bold flex items-center gap-3 hover:translate-y--4px transition-all shadow-lg active:scale-95">
					Diseñar algo único
					<span class="material-symbols-outlined group-hover:translate-x-1 transition-transform" data-icon="arrow_forward">arrow_forward</span>
				</a>
			</div>
			<div class="relative">
				<div class="rounded-[2.5rem] overflow-hidden shadow-2xl">
					<Image alt="Lithophany lamp" class="w-full h-auto object-cover aspect-4/5 md:aspect-square" src={principalImg} />
				</div>
				<div class="absolute -bottom-6 -left-6 md:-left-12 bg-white/90 backdrop-blur-md p-6 rounded-2xl shadow-xl flex items-center gap-4 border border-white/50">
					<div class="bg-primary/10 p-3 rounded-full">
						<span class="material-symbols-outlined text-primary" data-icon="verified">verified</span>
					</div>
					<div>
						<span class="block text-[10px] uppercase tracking-widest text-secondary font-bold mb-1">Calidad Premium</span>
						<span class="block font-headline font-bold text-on-surface">Acabados de Lujo</span>
					</div>
				</div>
			</div>
		</section>

		<section class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-8 border-b border-outline-variant/15 pb-10">
			<div class="max-w-2xl">
				<div class="flex items-center gap-2 mb-4">
					<span class="material-symbols-outlined text-primary text-sm" data-icon="straighten" data-weight="fill">straighten</span>
					<span class="font-label text-xs tracking-[0.2em] uppercase font-bold text-secondary">Vitalidad Técnica de Alta Precisión</span>
				</div>
				<h2 class="font-headline text-5xl md:text-7xl font-bold tracking-tighter leading-tight text-on-surface">Creamos <span class="text-primary italic">detalles</span> que florecen</h2>
			</div>
			<div class="max-w-sm text-on-surface-variant font-light text-lg leading-relaxed">
				Transformamos conceptos técnicos en realidades tangibles mediante fabricación aditiva, corte láser y personalización de alta fidelidad.
			</div>
		</section>

		<div id="galeria" class="scroll-mt-24">
			<!-- Barra de filtros por categoría -->
			<div class="flex flex-wrap items-center gap-3 mb-10" role="tablist" aria-label="Filtrar trabajos por categoría">
				<button
					type="button"
					data-filter="all"
					aria-selected="true"
					class="filter-btn active cursor-pointer px-5 py-2.5 rounded-full font-headline text-sm font-semibold transition-all duration-300 flex items-center gap-2 bg-primary text-on-primary shadow-md"
				>
					<span>Todos</span>
					<span class="text-xs px-2 py-0.5 rounded-full bg-white/20 text-white font-bold">
						{productosDestacados.length}
					</span>
				</button>

				{listaCategorias.map((cat) => (
					<button
						type="button"
						data-filter={cat.slug}
						aria-selected="false"
						class="filter-btn cursor-pointer px-5 py-2.5 rounded-full font-headline text-sm font-semibold transition-all duration-300 flex items-center gap-2 bg-surface-container-low text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface"
					>
						<span>{cat.nombre}</span>
						<span class="filter-badge text-xs px-2 py-0.5 rounded-full bg-surface-container-highest text-on-surface-variant font-bold transition-colors">
							{cat.count}
						</span>
					</button>
				))}
			</div>

			<!-- Cuadrícula simétrica de 3 columnas con imágenes cuadradas (1:1) -->
			<div id="productos-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
				{productosDestacados.map((producto) => {
					const nombreCategoria = getNombreCategoria(producto.data.categoria);
					return (
						<a
							href={`/productos/${producto.id}`}
							data-product-card
							data-category={producto.data.categoria}
							class="group relative aspect-square w-full overflow-hidden bg-surface-container-low rounded-2xl shadow-sm hover:shadow-xl transition-all duration-500 block"
						>
							<Image
								class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
								src={producto.data.imagen}
								alt={producto.data.titulo}
							/>

							<!-- Etiqueta superior de categoría y precio -->
							<div class="absolute top-4 left-4 right-4 flex items-center justify-between gap-2 z-10 pointer-events-none">
								<span class="bg-black/60 backdrop-blur-md text-white font-label text-[11px] tracking-[0.15em] uppercase px-3.5 py-1.5 rounded-full font-bold border border-white/15">
									{nombreCategoria}
								</span>
								{producto.data.precio && (
									<span class="bg-white/90 backdrop-blur-md text-on-surface font-headline text-xs px-3 py-1.5 rounded-full font-bold shadow-sm">
										${producto.data.precio.toFixed(2)}
									</span>
								)}
							</div>

							<!-- Overlay inferior con efecto hover moderno -->
							<div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/45 to-transparent opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-500 flex flex-col justify-end p-6 md:p-7">
								<span class="text-primary-fixed-dim font-label text-[10px] tracking-[0.2em] uppercase mb-1.5 font-bold">
									{nombreCategoria}
								</span>
								<h3 class="font-headline font-bold text-white text-xl leading-snug mb-4 line-clamp-2">
									{producto.data.titulo}
								</h3>

								<div class="flex items-center gap-3">
									<span class="w-fit bg-primary text-on-primary border border-primary/40 px-5 py-2.5 rounded-lg text-[11px] uppercase tracking-widest font-bold group-hover:bg-white group-hover:text-primary transition-all duration-300 flex items-center gap-2 shadow-lg">
										Ver más / Cotizar
										<span class="material-symbols-outlined text-[15px] transition-transform duration-300 group-hover:translate-x-1">arrow_forward</span>
									</span>
								</div>
							</div>
						</a>
					);
				})}
			</div>

			<!-- Estado vacío si se selecciona una categoría nueva sin productos aún -->
			<div id="empty-category-state" class="hidden py-16 text-center bg-surface-container-low rounded-2xl border border-outline-variant/20">
				<span class="material-symbols-outlined text-4xl text-primary mb-3 block">inventory_2</span>
				<h3 class="font-headline text-xl font-bold text-on-surface mb-2">Próximamente nuevos trabajos en esta categoría</h3>
				<p class="text-on-surface-variant text-sm max-w-md mx-auto">
					Estamos preparando nuevas muestras de esta categoría. Mientras tanto, puedes cotizar tu idea personalizada directamente por WhatsApp.
				</p>
			</div>
		</div>

		<div id="proceso" class="mt-16 lg:mt-24 border-t border-surface-variant pt-10 scroll-mt-24">
			<h2 class="font-headline text-2xl md:text-3xl font-bold text-on-surface mb-3">Cómo Trabajamos: De la Idea a la Entrega</h2>
			<p class="text-on-surface-variant max-w-2xl mb-8">Te acompañamos en cada etapa para convertir tu idea en una pieza única.</p>

			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="bg-surface-container-low p-6 rounded-lg">
					<span class="material-symbols-outlined text-3xl text-primary mb-4 block">upload_file</span>
					<h4 class="font-headline font-semibold text-lg text-on-surface mb-2">Paso 1: Envía tu Idea o Archivo</h4>
					<p class="text-on-surface-variant text-sm leading-relaxed">Recibimos archivos vectoriales (.ai, .svg, .dxf) y modelos 3D (.stl, .obj), o te asesoramos para diseñar tu proyecto personalizado desde cero.</p>
				</div>
				<div class="bg-surface-container-low p-6 rounded-lg">
					<span class="material-symbols-outlined text-3xl text-secondary mb-4 block">fact_check</span>
					<h4 class="font-headline font-semibold text-lg text-on-surface mb-2">Paso 2: Aprobación y Anticipo (50%)</h4>
					<p class="text-on-surface-variant text-sm leading-relaxed">Te enviamos el boceto técnico o vista previa digital para tu visto bueno. Todo pedido se agenda y comienza producción formalmente tras confirmar el anticipo del 50%.</p>
				</div>
				<div class="bg-surface-container-low p-6 rounded-lg">
					<span class="material-symbols-outlined text-3xl text-primary mb-4 block">precision_manufacturing</span>
					<h4 class="font-headline font-semibold text-lg text-on-surface mb-2">Paso 3: Fabricación y Acabados</h4>
					<p class="text-on-surface-variant text-sm leading-relaxed">Cortamos en láser MDF o imprimimos en 3D cuidando cada detalle y tiempo de postprocesado. Los tiempos de taller estándar van de 3 a 5 días hábiles según la complejidad.</p>
				</div>
				<div class="bg-surface-container-low p-6 rounded-lg">
					<span class="material-symbols-outlined text-3xl text-secondary mb-4 block">local_shipping</span>
					<h4 class="font-headline font-semibold text-lg text-on-surface mb-2">Paso 4: Control de Calidad y Entrega</h4>
					<p class="text-on-surface-variant text-sm leading-relaxed">Te enviamos fotos de tu pieza terminada, coordinamos el saldo restante y despachamos mediante entrega local o envíos seguros a nivel nacional.</p>
				</div>
			</div>

			<details class="mt-8 rounded-lg border border-primary/20 bg-primary-fixed/30 p-6 group">
				<summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-headline text-lg font-bold text-on-surface">
					<span class="flex items-center gap-3">
						<span class="material-symbols-outlined text-primary">policy</span>
						Políticas de Pedido y Taller
					</span>
					<span class="material-symbols-outlined text-primary transition-transform group-open:rotate-180">expand_more</span>
				</summary>
				<div class="mt-6 grid md:grid-cols-3 gap-6 text-sm text-on-surface-variant leading-relaxed">
					<div>
						<h4 class="font-headline font-semibold text-on-surface mb-2">Anticipo y Reserva de Cupo</h4>
						<p>Cada pieza se fabrica bajo demanda. El anticipo del 50% garantiza la compra de material y el turno de máquina en taller; en caso de cancelación una vez iniciada la producción, dicho abono no es reembolsable.</p>
					</div>
					<div>
						<h4 class="font-headline font-semibold text-on-surface mb-2">Fechas de Entrega Fijas</h4>
						<p>Al confirmar tu pedido se establece una fecha límite de entrega programada. Si requieres adelantar imprevistamente la entrega, dependerá de la disponibilidad en cola y aplicará un recargo por servicio express (+30%).</p>
					</div>
					<div>
						<h4 class="font-headline font-semibold text-on-surface mb-2">Postprocesado y Detalle</h4>
						<p>Las piezas con pintura, ensamblado complejo o acabados especiales tienen tiempos de curado específicos que se respetan para garantizar la máxima calidad.</p>
					</div>
				</div>
			</details>
		</div>	

		<section class="mt-32 bg-secondary-container rounded-sm p-8 md:p-16 flex flex-col md:flex-row items-center justify-between gap-10 overflow-hidden relative">
			<div class="relative z-10 text-center md:text-left">
				<h2 class="font-headline text-3xl md:text-5xl font-bold text-on-secondary-container mb-4 tracking-tighter">¿Tienes un proyecto en mente?</h2>
				<p class="text-on-secondary-container/80 text-lg max-w-md">Envíanos tus archivos o cuéntanos tu idea para recibir una cotización técnica personalizada.</p>
			</div>
			<a href={`https://wa.me/${whatsappNumber}`} target="_blank" class="relative z-10 bg-primary text-on-primary px-10 py-5 font-bold uppercase tracking-widest text-sm flex items-center gap-4 hover:translate-y--1px transition-all shadow-xl active:scale-95">
				<span class="material-symbols-outlined" data-icon="chat" data-weight="fill">chat</span>
				Cotizar por WhatsApp
			</a>
			<span class="absolute -right-10 -bottom-10 material-symbols-outlined text-on-secondary-container/5 text-[240px] rotate-45 select-none" data-icon="straighten">straighten</span>
		</section>

		
	</main>

	<Footer />
</Layout>

<script>
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const productCards = document.querySelectorAll<HTMLElement>('[data-product-card]');
	const emptyState = document.getElementById('empty-category-state');

	filterButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const selectedCategory = btn.getAttribute('data-filter') || 'all';

			// Actualizar estilos de botones activos/inactivos
			filterButtons.forEach((b) => {
				const isSelected = b === btn;
				b.setAttribute('aria-selected', String(isSelected));
				const badge = b.querySelector('.filter-badge');

				if (isSelected) {
					b.classList.remove('bg-surface-container-low', 'text-on-surface-variant', 'hover:bg-surface-container-high', 'hover:text-on-surface');
					b.classList.add('bg-primary', 'text-on-primary', 'shadow-md');
					if (badge) {
						badge.classList.remove('bg-surface-container-highest', 'text-on-surface-variant');
						badge.classList.add('bg-white/20', 'text-white');
					}
				} else {
					b.classList.add('bg-surface-container-low', 'text-on-surface-variant', 'hover:bg-surface-container-high', 'hover:text-on-surface');
					b.classList.remove('bg-primary', 'text-on-primary', 'shadow-md');
					if (badge) {
						badge.classList.add('bg-surface-container-highest', 'text-on-surface-variant');
						badge.classList.remove('bg-white/20', 'text-white');
					}
				}
			});

			// Filtrar tarjetas de productos
			let visibleCount = 0;
			productCards.forEach((card) => {
				const cardCategory = card.getAttribute('data-category');
				const shouldShow = selectedCategory === 'all' || cardCategory === selectedCategory;

				if (shouldShow) {
					card.classList.remove('hidden');
					card.classList.remove('animate-card-in');
					// Forzar reflow para reiniciar la animación suavemente
					void card.offsetWidth;
					card.classList.add('animate-card-in');
					visibleCount++;
				} else {
					card.classList.add('hidden');
					card.classList.remove('animate-card-in');
				}
			});

			// Mostrar u ocultar mensaje de categoría vacía
			if (emptyState) {
				if (visibleCount === 0) {
					emptyState.classList.remove('hidden');
				} else {
					emptyState.classList.add('hidden');
				}
			}
		});
	});
</script>
